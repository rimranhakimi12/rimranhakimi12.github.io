---
import { site } from '../../site';
import Socials from './Socials.astro';
---
<footer class="bg-ink px-6 py-8 text-mist sm:px-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 sm:flex-row">
    <p class="flex items-baseline gap-3 text-xs tracking-wide">
      <span aria-hidden="true" class="font-display text-xl text-white">{site.monogram}</span>
      <span>© {new Date().getFullYear()} {site.name}</span>
    </p>
    <Socials />
  </div>
</footer>
