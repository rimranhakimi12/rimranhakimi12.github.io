---
import Section from './Section.astro';

interface Props {
  groups: { group: string; items: string[]; order?: number }[];
}
const groups = [...Astro.props.groups].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---
<Section id="skills" label="Tech stack" heading="Skills & tools" tone="mist">
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      groups.map(({ group, items }) => (
        <li class="rounded-sm bg-paper p-6 shadow-sm">
          <h3 class="font-display text-xl">{group}</h3>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {items.map((item) => (
              <li class="rounded-sm border border-ink/10 px-2 py-0.5 text-sm text-slate">{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>
