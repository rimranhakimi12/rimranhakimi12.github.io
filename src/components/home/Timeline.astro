---
import { formatPeriod } from '../../lib/format';
import Section from './Section.astro';

type Entry = {
  kind: 'education' | 'internship' | 'part-time';
  org: string;
  title: string;
  start: Date;
  end?: Date;
  bullets: readonly string[];
};
interface Props {
  entries: readonly Entry[];
  /** Pre-processed images for the trail collage; none means a plain timeline. */
  photos?: { src: string; srcset?: string }[];
}
const { photos = [] } = Astro.props;
const entries = [...Astro.props.entries].sort((a, b) => b.start.getTime() - a.start.getTime());
const kindLabel = { education: 'Education', internship: 'Internship', 'part-time': 'Part-time' };

// Winding trail from the bottom (start) to the top (now) in a 400x1000 box.
const trail = 'M200 985 C 60 900, 360 820, 230 720 S 40 560, 170 470 S 380 300, 250 220 S 110 90, 215 22';
// Where each photo sits along the trail (cycled if there are more than four).
const spots = [
  'top-[6%] right-[4%] rotate-3',
  'top-[29%] left-[2%] -rotate-3',
  'top-[52%] right-[8%] rotate-2',
  'top-[75%] left-[8%] -rotate-2',
];
const polaroid = 'rounded-sm bg-white p-2 pb-6 shadow-lg';
---
<Section id="timeline" label="Experience" heading="Study & work timeline" tone="slate">
  <div class:list={['grid gap-12', photos.length > 0 && 'lg:grid-cols-[1fr_minmax(0,24rem)]']}>
    <ol class="relative space-y-10 border-l border-mist/30 pl-8">
      {
        entries.map((e) => (
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[2.3rem] top-1.5 h-3 w-3 rounded-full border-2 border-mist bg-slate" />
            <p class="text-xs uppercase tracking-[0.2em] text-mist">
              <span class="mr-3 rounded-full bg-mauve px-2.5 py-0.5 font-semibold text-white">{kindLabel[e.kind]}</span>
              {formatPeriod(e.start, e.end)}
            </p>
            <h3 class="mt-3 font-display text-2xl text-white">{e.title}</h3>
            <p class="text-mist">{e.org}</p>
            {e.bullets.length > 0 && (
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-mist marker:text-mist/60">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    {
      photos.length > 0 && (
        <>
          {/* Desktop: decorative trail with photos pinned along it. */}
          <div data-trail aria-hidden="true" class="relative hidden min-h-[40rem] lg:block">
            <svg viewBox="0 0 400 1000" preserveAspectRatio="none" class="absolute inset-0 h-full w-full overflow-visible">
              <mask id="trail-reveal" maskUnits="userSpaceOnUse" x="-20" y="-20" width="440" height="1040">
                <path class="trail-draw" d={trail} pathLength="1" fill="none" stroke="white" stroke-width="14" vector-effect="non-scaling-stroke" />
              </mask>
              <path
                d={trail}
                mask="url(#trail-reveal)"
                fill="none"
                stroke="var(--color-mist)"
                stroke-opacity="0.55"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-dasharray="2 10"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            <span class="absolute bottom-0 left-1/2 h-3 w-3 -translate-x-1/2 translate-y-1/2 rounded-full border-2 border-mist bg-slate" />
            <span class="absolute left-[54%] top-0 -translate-y-full text-xs uppercase tracking-[0.2em] text-mist">
              <span class="text-mauve">▲</span> now
            </span>
            {photos.map((p, i) => (
              <figure class:list={['absolute w-40 transition-transform duration-300 hover:rotate-0', polaroid, spots[i % spots.length]]}>
                <img src={p.src} srcset={p.srcset} sizes="10rem" alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
              </figure>
            ))}
          </div>

          {/* Smaller screens: the same photos as a swipeable strip. */}
          <ul aria-hidden="true" class="-mx-2 flex snap-x gap-4 overflow-x-auto scroll-px-2 px-2 pb-4 lg:hidden">
            {photos.map((p, i) => (
              <li class:list={['w-40 shrink-0 snap-start', polaroid, i % 2 ? 'rotate-1' : '-rotate-1']}>
                <img src={p.src} srcset={p.srcset} sizes="10rem" alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</Section>
