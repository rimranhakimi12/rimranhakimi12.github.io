---
interface Props {
  id: string;
  label: string;
  heading: string;
  tone?: 'paper' | 'mist' | 'slate';
}
const { id, label, heading, tone = 'paper' } = Astro.props;
const toneClass = { paper: 'bg-paper text-ink', mist: 'bg-mist text-ink', slate: 'bg-slate text-paper' }[tone];
const labelClass = tone === 'slate' ? 'text-mist' : 'text-mauve-deep';
---
<section id={id} aria-labelledby={`${id}-heading`} class:list={['scroll-mt-16 px-5 py-20 sm:px-10 lg:scroll-mt-0 lg:py-24', toneClass]}>
  <div class="reveal mx-auto max-w-5xl">
    <p class:list={['text-xs font-semibold uppercase tracking-[0.3em]', labelClass]}>{label}</p>
    <h2 id={`${id}-heading`} class="mt-3 mb-10 font-display text-3xl leading-tight sm:text-4xl">{heading}</h2>
    <slot />
  </div>
</section>
