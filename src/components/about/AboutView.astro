---
import type { CollectionEntry } from 'astro:content';
import Currently from './Currently.astro';
import Favourites from './Favourites.astro';
import Hobbies from './Hobbies.astro';
import Stats from './Stats.astro';
import Tinkering from './Tinkering.astro';

interface Props {
  data: CollectionEntry<'about'>['data'];
}
const { data } = Astro.props;
---
<header data-about-hero class="bg-paper px-5 pt-16 pb-12 sm:px-10 lg:pt-24">
  <div class="mx-auto max-w-5xl">
    <a href="/" class="text-xs uppercase tracking-[0.18em] text-slate hover:text-ink hover:underline">← Back to home</a>
    <p class="mt-10 text-xs font-semibold uppercase tracking-[0.3em] text-mauve-deep">About me, the casual version</p>
    <h1 class="mt-4 font-display text-5xl leading-tight text-ink sm:text-6xl">{data.greeting}</h1>
    <div class="case-body mt-6 max-w-2xl text-lg">
      <slot />
    </div>
  </div>
</header>

<Hobbies items={data.hobbies} />
<Tinkering items={data.tinkering} />
<Currently items={data.currently} />
<Favourites items={data.favourites} />
<Stats items={data.stats} />

<section aria-labelledby="thanks-heading" class="bg-paper px-5 py-20 text-center sm:px-10">
  <h2 id="thanks-heading" class="font-display text-3xl sm:text-4xl">Thanks for stopping by!</h2>
  <p class="mt-3 text-slate">Now that you know the person, come see the work.</p>
  <div class="mt-8 flex flex-wrap justify-center gap-6">
    <a href="/#projects" class="rounded-sm bg-mauve px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-white transition-colors hover:bg-mauve-deep">
      See my projects
    </a>
    <a href="/#contact" class="self-center border-b border-ink pb-1 text-xs font-semibold uppercase tracking-[0.2em] text-ink hover:border-mauve hover:text-mauve-deep">
      Say hi
    </a>
  </div>
</section>
