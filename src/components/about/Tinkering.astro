---
import Section from '../home/Section.astro';

interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="tinkering" label="Side quests" heading="Things I tinker with" tone="mist">
      <ul class="grid gap-5 md:grid-cols-3">
        {items.map((t) => (
          <li class="rounded-2xl bg-paper p-6 shadow-sm">
            <h3 class="font-display text-xl">{t.title}</h3>
            <p class="mt-2 text-slate">{t.text}</p>
          </li>
        ))}
      </ul>
    </Section>
  )
}
