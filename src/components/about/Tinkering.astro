---
import Section from '../home/Section.astro';

interface Props {
  items: { title: string; text: string; kit: string[] }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="tinkering" label="Tinkering" heading="Side quests and the kit behind them" tone="mist">
      {/* Workbench rows rather than cards: story on the left, a parts-list panel on the right. */}
      <ol class="divide-y divide-ink/15 border-y border-ink/15">
        {items.map((t, i) => (
          <li class="grid gap-x-8 gap-y-5 py-10 md:grid-cols-[3rem_1fr_17rem]">
            <span aria-hidden="true" class="font-display text-2xl text-mauve-deep">{String(i + 1).padStart(2, '0')}</span>
            <div class:list={[t.kit.length === 0 && 'md:col-span-2']}>
              <h3 class="font-display text-2xl text-ink">{t.title}</h3>
              <p class="mt-3 max-w-prose leading-relaxed text-slate">{t.text}</p>
            </div>
            {t.kit.length > 0 && (
              <div class="rounded-sm border border-ink/15 bg-paper px-5 py-4">
                <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-mauve-deep">The kit</p>
                <ul class="mt-2 divide-y divide-dotted divide-ink/25 text-sm text-ink">
                  {t.kit.map((item) => <li class="py-1.5">{item}</li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ol>
    </Section>
  )
}
