---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../home/Section.astro';

interface Props {
  items: { title: string; text: string; image?: ImageMetadata; imageAlt: string }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="hobbies" label="Off the clock" heading="Things I enjoy">
      <ul class="space-y-16">
        {items.map((h, i) => (
          <li class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            {h.image && (
              <figure
                class:list={[
                  'rounded-sm bg-white p-3 pb-10 shadow-md ring-1 ring-ink/5 transition-transform duration-300 hover:rotate-0',
                  i % 2 ? 'rotate-2 md:order-2' : '-rotate-2',
                ]}
              >
                <Image src={h.image} alt={h.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 28rem, 90vw" class="aspect-[4/3] w-full object-cover" />
              </figure>
            )}
            <div>
              <h3 class="font-display text-2xl text-ink sm:text-3xl">{h.title}</h3>
              <p class="mt-3 text-lg leading-relaxed text-slate">{h.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )
}
