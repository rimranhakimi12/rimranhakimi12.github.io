---
import Section from '../home/Section.astro';

interface Props {
  items: { group: string; gear: string[] }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="setup" label="The gear" heading="My setup">
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((g) => (
          <div class="rounded-2xl border border-ink/10 bg-white p-5">
            <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-mauve-deep">{g.group}</dt>
            <dd class="mt-3">
              <ul class="space-y-1.5 text-ink">
                {g.gear.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </Section>
  )
}
