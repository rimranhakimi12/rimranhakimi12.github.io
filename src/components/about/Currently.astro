---
import Section from '../home/Section.astro';

interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="currently" label="Right now" heading="Currently">
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {items.map((c) => (
          <div class="rounded-2xl border border-ink/10 bg-white p-5">
            <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-mauve-deep">{c.label}</dt>
            <dd class="mt-2 font-display text-lg text-ink">{c.value}</dd>
          </div>
        ))}
      </dl>
    </Section>
  )
}
