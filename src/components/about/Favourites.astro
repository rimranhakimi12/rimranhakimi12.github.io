---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../home/Section.astro';

interface Props {
  items: { title: string; kind: string; image?: ImageMetadata }[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <Section id="favourites" label="All-time picks" heading="Favourites shelf">
      <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        {items.map((f, i) => (
          <li class:list={['transition-transform duration-300 hover:-translate-y-1 motion-reduce:hover:translate-y-0', i % 2 ? 'rotate-1' : '-rotate-1']}>
            {f.image && (
              <Image src={f.image} alt={`${f.title} cover`} widths={[240, 400]} sizes="(min-width: 1024px) 10rem, 45vw" class="aspect-[2/3] w-full rounded-lg object-cover shadow-md" />
            )}
            <p class="mt-3 text-sm font-medium text-ink">{f.title}</p>
            <p class="text-xs uppercase tracking-[0.15em] text-slate">{f.kind}</p>
          </li>
        ))}
      </ul>
    </Section>
  )
}
