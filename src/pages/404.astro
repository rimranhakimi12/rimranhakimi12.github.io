---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist." navPrefix="/">
  <section class="flex min-h-[70vh] items-center px-5 py-20 sm:px-10">
    <div class="mx-auto max-w-5xl">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-mauve-deep">Error 404</p>
      <h1 class="mt-3 font-display text-5xl text-ink">This page wandered off.</h1>
      <p class="mt-4 max-w-xl text-lg text-slate">The link may be old or mistyped.</p>
      <a href="/" class="mt-10 inline-block rounded-sm bg-mauve px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-white hover:bg-mauve-deep">
        Back to home
      </a>
    </div>
  </section>
</BaseLayout>
