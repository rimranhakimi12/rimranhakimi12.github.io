---
import { getEntry, render } from 'astro:content';
import AboutView from '../components/about/AboutView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

const entry = await getEntry('about', 'index');
if (!entry) throw new Error('Missing src/content/about/index.md');
const { Content } = await render(entry);
---
<BaseLayout title="About me" description={`The casual side of ${site.name}: hobbies, interests and what I'm into right now.`} navPrefix="/">
  <AboutView data={entry.data}>
    <Content />
  </AboutView>
</BaseLayout>
